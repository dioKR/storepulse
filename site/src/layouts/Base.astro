---
import "../styles/global.css";

type Lang = "en" | "ko" | "ja" | "zh-cn" | "zh-tw";

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  page?: "home" | "tutorial";
}

const { title, description, lang = "en", page = "home" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const site = (Astro.site?.origin ?? "https://diokr.github.io") + base;

const LANGS: Record<
  Lang,
  {
    path: string;
    label: string;
    htmlLang: string;
    hreflang: string;
    tutorialLabel: string;
    readmeFile: string;
    readmeLabel: string;
  }
> = {
  en: {
    path: "",
    label: "EN",
    htmlLang: "en",
    hreflang: "en",
    tutorialLabel: "tutorial",
    readmeFile: "README.md",
    readmeLabel: "README",
  },
  ko: {
    path: "/ko",
    label: "KO",
    htmlLang: "ko",
    hreflang: "ko",
    tutorialLabel: "튜토리얼",
    readmeFile: "README.ko.md",
    readmeLabel: "한국어 README",
  },
  ja: {
    path: "/ja",
    label: "JA",
    htmlLang: "ja",
    hreflang: "ja",
    tutorialLabel: "チュートリアル",
    readmeFile: "README.ja.md",
    readmeLabel: "日本語 README",
  },
  "zh-cn": {
    path: "/zh-cn",
    label: "简",
    htmlLang: "zh-Hans",
    hreflang: "zh-Hans",
    tutorialLabel: "教程",
    readmeFile: "README.zh-CN.md",
    readmeLabel: "简体中文 README",
  },
  "zh-tw": {
    path: "/zh-tw",
    label: "繁",
    htmlLang: "zh-Hant",
    hreflang: "zh-Hant",
    tutorialLabel: "教學",
    readmeFile: "README.zh-TW.md",
    readmeLabel: "繁體中文 README",
  },
};

const cur = LANGS[lang];
const homeHref = `${base}${cur.path}/`;
const tutorialHref = `${base}${cur.path}/tutorial/`;
const others = (Object.keys(LANGS) as Lang[]).filter((l) => l !== lang);

const pageSuffix = page === "tutorial" ? "tutorial/" : "";
const alternateUrl = (l: Lang) => `${site}${LANGS[l].path}/${pageSuffix}`;
const canonicalUrl = alternateUrl(lang);
const ogImageUrl = `${site}/og.png`;
const ogImageAlt = "storepulse CLI — App Store Connect + Google Play release monitor";

const jsonLd =
  page === "home"
    ? {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: "storepulse",
        description:
          "storepulse CLI — App Store Connect + Google Play release monitor. One terminal board with live versions, review states, rollout percentages and test tracks for every iOS & Android app.",
        applicationCategory: "DeveloperApplication",
        operatingSystem: "macOS, Linux, Windows",
        url: `${site}/`,
        image: ogImageUrl,
        license: "https://github.com/dioKR/storepulse/blob/main/LICENSE",
        offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
        sameAs: ["https://github.com/dioKR/storepulse", "https://www.npmjs.com/package/storepulse"],
      }
    : null;
---

<!doctype html>
<html lang={cur.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content="storepulse" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {(Object.keys(LANGS) as Lang[]).map((l) => (
      <link rel="alternate" hreflang={LANGS[l].hreflang} href={alternateUrl(l)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={alternateUrl("en")} />
    {jsonLd && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body>
    <div class="topbar">
      <div class="wrap">
        <a class="brand" href={homeHref}>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 96" width="26" height="26" aria-hidden="true">
            <rect x="4" y="4" width="88" height="88" rx="10" fill="#17161A" stroke="#46414F" stroke-width="2"></rect>
            <path d="M14 52 H32 L40 32 L52 68 L60 52 H70" fill="none" stroke="#E24FD8" stroke-width="8" stroke-linecap="square"></path>
            <rect x="74" y="45" width="9" height="14" fill="#E24FD8"></rect>
          </svg>
          storepulse<span class="cursor">_</span>
        </a>
        <nav>
          <a href={tutorialHref}>{cur.tutorialLabel}</a>
          <a href="https://github.com/dioKR/storepulse">github ↗</a>
          <span class="langs" aria-label="Languages">
            {others.map((l) => (
              <a href={`${base}${LANGS[l].path}/`} class="lang" hreflang={LANGS[l].hreflang}>{LANGS[l].label}</a>
            ))}
          </span>
        </nav>
      </div>
    </div>
    <slot />
    <footer>
      <div class="wrap">
        <span>© 2026 storepulse contributors</span>
        <a href="https://github.com/dioKR/storepulse/blob/main/LICENSE">MIT License</a>
        <a href="https://github.com/dioKR/storepulse">GitHub</a>
        <a href={`https://github.com/dioKR/storepulse/blob/main/${cur.readmeFile}`}>{cur.readmeLabel}</a>
      </div>
    </footer>
  </body>
</html>

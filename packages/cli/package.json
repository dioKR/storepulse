{
  "name": "storepulse",
  "version": "0.8.0",
  "description": "storepulse CLI — App Store Connect + Google Play release monitor. Live versions, review states, rollout % and test tracks for all your iOS & Android apps in one terminal board.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "storepulse": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dioKR/storepulse.git",
    "directory": "packages/cli"
  },
  "homepage": "https://diokr.github.io/storepulse/",
  "bugs": "https://github.com/dioKR/storepulse/issues",
  "engines": {
    "node": ">=20.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build && node ../../scripts/gen-dashboard-i18n.mjs && node ../../scripts/copy-dashboard.mjs"
  },
  "dependencies": {
    "@storepulse/core": "workspace:*",
    "picocolors": "^1.1.1"
  },
  "keywords": [
    "app-store-connect",
    "google-play",
    "google-play-console",
    "app-store",
    "testflight",
    "release-monitor",
    "app-release",
    "mobile-devops",
    "ios",
